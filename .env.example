# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional (F4 web agent): https://tavily.com
TAVILY_API_KEY=
# Offline demo mode without any keys:
MOCK_LLM=0

# --- Gladiator Telegram bot (bot/) ---
# @BotFather ga /newbot yozib oling:
BOT_TOKEN=
# Admin Telegram ID lari, vergul bilan. Botga /id yozsangiz chiqadi:
ADMIN_IDS=
# Ixtiyoriy — Google Sheets ko'zgusi. Bo'sh qolsa bot ularsiz ishlayveradi:
GOOGLE_SHEET_ID=
GOOGLE_CREDENTIALS_JSON=

# --- Claude Telegram bot (claude_bot/) ---
# @BotFather dan olingan ALOHIDA bot tokeni (Gladiator boti bilan aralashmasin):
CLAUDE_BOT_TOKEN=
# https://console.anthropic.com/settings/keys dan olinadi:
ANTHROPIC_API_KEY=
# Ixtiyoriy sozlamalar — ko'rsatilganlari default qiymatlar:
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=medium
CLAUDE_MAX_TOKENS=16000
CLAUDE_HISTORY_LIMIT=20
CLAUDE_RATE_LIMIT=10
# Bo'sh qolsa bot hammaga ochiq. Faqat o'zingiz uchun bo'lsa — /id dagi raqam:
CLAUDE_ALLOWED_USER_IDS=
